:pPr><w:r w:rsidRPr="00CC542F"><w:t>Equal monthly fee for each of the 11 months of the academic year.</w:t></w:r></w:p><w:p w14:paraId="20676FE1" w14:textId="77777777" w:rsidR="00CC542F" w:rsidRDefault="00CC542F" w:rsidP="00CC542F"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Fees are expected to be paid on time each month, regardless of attendance.</w:t></w:r></w:p><w:p w14:paraId="536AA4B8" w14:textId="77777777" w:rsidR="00CC542F" w:rsidRDefault="00CC542F" w:rsidP="00CC542F"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>As an academic institution, your place in class is reserved and the tuition secures your spot and supports the ongoing operation of the Academy.</w:t></w:r></w:p><w:p w14:paraId="01F3388B" w14:textId="288C89E2" w:rsidR="00CC542F" w:rsidRDefault="00CC542F" w:rsidP="00CC542F"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Missed classes, for any reason</w:t></w:r><w:r w:rsidR="00442025"><w:t xml:space="preserve"> (except serious illness, proven on paper)</w:t></w:r><w:r><w:t xml:space="preserve"> do not result in fee reductions or credits.</w:t></w:r></w:p><w:p w14:paraId="002B5F18" w14:textId="7580EF27" w:rsidR="00C62C42" w:rsidRDefault="00C62C42" w:rsidP="00CC542F"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Each student is entitled to two make up session per month according to existing schedule.</w:t></w:r></w:p><w:p w14:paraId="6ACCDE65" w14:textId="77777777" w:rsidR="00CC542F" w:rsidRDefault="00CC542F" w:rsidP="00CC542F"/><w:p w14:paraId="507CC7D9" w14:textId="5AD40F1D" w:rsidR="00CC542F" w:rsidRDefault="00CC542F" w:rsidP="00CC542F"><w:r><w:rPr><w:rFonts w:ascii="Segoe UI Emoji" w:hAnsi="Segoe UI Emoji" w:cs="Segoe UI Emoji"/></w:rPr><w:t>🔹</w:t></w:r><w:r><w:t xml:spa